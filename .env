# .env — station forge: the live slot (same names as .env.example). Values EMPTY as built; fill on your private copy (ORDER 5).
# Names only. Values are EMPTY as built: the kit never invents a secret value (ORDER 5: the operator may fill and
# commit real values on his private copy; no hook blocks it). Copy to .env (tracked, same names, empty) and fill there.
# Each name below says which held component reads it and where (file at the pinned commit), so nothing is guessed.
# These CLIs run only in a run-tree (python3 tools/kit/runtree.py), never inside the station; export from here.
#
# --- langchain-ai/openwiki @ 7c469e5 (provider table README.md 'Model providers', lines 466-477; keys are
#     normally kept in ~/.openwiki/.env per the README; listed here so a run-tree can be given them explicitly) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
BOB_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
COPILOT_API_KEY=
# web-search connector (README 'Connect your sources', line 429)
TAVILY_API_KEY=
# LangSmith connector (README line 450)
OPENWIKI_LANGSMITH_API_KEY=
#
# --- evo-hq/evo @ c70c04b (plugins/evo/skills/infra-setup/references/provider-matrix.md; sandbox providers in
#     plugins/evo/src/evo/backends/sandbox_providers/; finetuning references) ---
E2B_API_KEY=
DAYTONA_API_KEY=
EVO_SANDBOX_BEARER_TOKEN=
TINKER_API_KEY=
WANDB_API_KEY=
HF_TOKEN=
#
# --- styler-ai/ProjectAtlas @ bed8ba3: no API key is named in README.md or docs/*.md at the pin (local index). ---
# --- morluto/rea @ 1bd5c5c: no API key; REA is local-only (AGENTS.md 'Product and Authority'). ---
#
# --- telemetry opt-outs (not secrets; pre-set because the switch is proven by file:line at the pin) ---
# openwiki: src/telemetry/gates.ts:28-32 (truthy OPENWIKI_TELEMETRY_DISABLED or DO_NOT_TRACK skips the send, senders.ts:136)
OPENWIKI_TELEMETRY_DISABLED=1
# evo: plugins/evo/src/evo/telemetry.py:102-112 (EVO_TELEMETRY in 0/false/off/no, or DO_NOT_TRACK in 1/true/yes)
EVO_TELEMETRY=0
DO_NOT_TRACK=1
